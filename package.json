{
  "name": "valorant-lineups",
  "version": "1.0.0",
  "private": true,
  "author": "komolab",
  "description": "VALORANT のスキル定点 YouTube 動画をエージェント別・マップ別に、プロの試合（VCT）の公式 VOD をマップ別にまとめた静的サイト",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "meta": "node scripts/build-meta.mjs",
    "merge": "node scripts/merge-videos.mjs",
    "verify": "node scripts/verify-videos.mjs",
    "shorts": "node scripts/detect-shorts.mjs",
    "x-media": "node scripts/check-x-media.mjs",
    "discover": "node scripts/discover-videos.mjs",
    "channels": "node scripts/add-channel.mjs",
    "build": "npm run meta && npm run merge",
    "vct:events": "node scripts/vct/discover-events.mjs",
    "vct:fetch": "node scripts/vct/fetch-matches.mjs",
    "vct:logos": "node scripts/vct/fetch-logos.mjs",
    "vct:vods": "node scripts/vct/check-vods.mjs",
    "vct:merge": "node scripts/vct/merge-matches.mjs",
    "vct:build": "npm run vct:events && npm run vct:fetch && npm run vct:logos && npm run vct:vods && npm run vct:merge",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test"
  },
  "engines": { "node": ">=22" }
}
